# Copy to .env to override defaults.
NIBO_OLLAMA_BASE_URL=http://localhost:11434
NIBO_OLLAMA_MODEL=gemma4
# NIBO_OLLAMA_VISION_MODEL=gemma4   # used to read scanned PDFs; defaults to NIBO_OLLAMA_MODEL
NIBO_OLLAMA_THINK=false
# auto | ollama | mock   (auto = Ollama if the model is served, else offline mock extractor)
NIBO_LLM_MODE=auto

# Keep the local model resident across reviews. Tune context for your packet sizes.
NIBO_OLLAMA_KEEP_ALIVE=15m
NIBO_OLLAMA_NUM_CTX=16384
# Experimental: strips schema metadata, retains constraints and Pydantic validation.
NIBO_OLLAMA_COMPACT_SCHEMA=false

# CPU scheduling: each document still goes through Ollama. Original worker count was 4.
NIBO_EXTRACTION_WORKERS=1
# Ask the model to reserve notes for genuine ambiguity, preserving returned notes verbatim.
NIBO_OLLAMA_CONCISE_NOTES=true

# Bounded gap resolver. Mock DMV fixtures are empty by default; no invented matches.
NIBO_GAP_RESOLUTION_ENABLED=true
NIBO_GAP_DMV_MOCK_MODE=true
NIBO_GAP_DMV_RECORDS={}
NIBO_GAP_TIMEOUT_S=10
NIBO_GAP_BATCH_TIMEOUT_S=30
NIBO_GAP_PARALLELISM=4
# NIBO_GAP_DMV_BASE_URL=https://your-contracted-provider.example
# The HTTP adapter uses a placeholder contract; no state DMV is integrated yet.
